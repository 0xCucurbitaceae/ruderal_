# Public configuration, loaded in development and in production alike.
# Committed on purpose: none of these are secrets, and keeping them here means a
# host needs no setup to build.
#
# There is no read token. Sanity hides any document whose id contains a dot from
# unauthenticated reads, which is why the content once looked unreadable; the
# ids no longer contain dots, so the public dataset really is public.
NEXT_PUBLIC_SANITY_PROJECT_ID=zxtziudd
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SITE_URL=https://www.ruderal.ch
