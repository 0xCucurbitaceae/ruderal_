NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Absolute site URL, used for OpenGraph and canonical tags.
NEXT_PUBLIC_SITE_URL=https://example.org

# Sanity read token, used only while building. Not NEXT_PUBLIC_, so it is never
# bundled into the browser. Create one at sanity.io/manage under API > Tokens.
SANITY_READ_TOKEN=
